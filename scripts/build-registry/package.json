{
  "name": "build-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Builds the shadcn registry the Video.js Skins site hosts under /r from every skin's source files",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./names": {
      "types": "./names.ts",
      "default": "./names.ts"
    }
  },
  "scripts": {
    "build": "node build.ts",
    "e2e": "node e2e/run.mjs",
    "test": "vp test run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22",
    "build-skin": "workspace:*",
    "playwright-core": "1.56.0",
    "shadcn": "^4.21.0",
    "typescript": "^5",
    "vite-plus": "catalog:"
  }
}
