# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.turbo/
dist/
skins/**/dist/
# The shadcn registry the site hosts under /r, generated from the skins' open editions by scripts/build-registry.
/site/public/r/
# A local restore of the Media Chrome themes (`git archive media-chrome themes/<name> | tar x`) for the byte-for-byte
# artwork checks in some skin tests; the sources live on the `media-chrome` branch.
/themes/
node_modules/
site/.content-collections/

# pnpm
.pnpm-store/
.pnpm-debug.log*

# Vite+ (task cache lives in node_modules/.vite/task-cache; git hook shims in .vite-hooks/_/)
.vite/
.vite-hooks/_/
*.bundle
